# copy to .env and fill in
HOST_WS_PORT=8765
CHROME_DEBUG_PORT=9222
# TypeSafe System One (Jev) — https://typesafe.ai
TYPESAFE_API_KEY=
# optional overrides (SDK defaults: https://api.typesafe.ai / jev-latest)
#TYPESAFE_BASE_URL=
#TYPESAFE_MODEL=
# OpenAI-compatible quiz solver endpoint (default: GLM free tier)
SOLVER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SOLVER_API_KEY=
SOLVER_MODEL=glm-4.5-flash
# never auto-submit exams when false (default)
AUTO_SUBMIT=false
